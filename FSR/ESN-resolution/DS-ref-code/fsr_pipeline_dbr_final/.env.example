# FSR pipeline local configuration
# Copy this file to .env before using deploy.py from a clean environment.

# Databricks workspace access
DATABRICKS_HOST=https://gevernova-ai-dev-dbr.cloud.databricks.com
DATABRICKS_TOKEN=

# Databricks runtime / pipeline overrides
DBR_SECRET_SCOPE=fsr-pipeline
VS_ENDPOINT_NAME=pw-ser-sdg-vector-search
VS_INDEX_NAME=main.gp_services_sdg_poc.vs_field_service_report
EMBEDDINGS_TABLE=main.gp_services_sdg_poc.field_service_report

# LiteLLM proxy used for ESN extraction
LITELLM_BASE_URL=https://dev-gateway.apps.gevernova.net/
LITELLM_API_KEY=
ESN_LLM_MODEL=azure-gpt-4o

# Optional corporate proxy for local runs only
CORP_PROXY=
