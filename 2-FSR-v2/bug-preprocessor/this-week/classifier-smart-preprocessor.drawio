;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(252, 252, 252));&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span&gt;&quot;primary_equip_type&quot;&lt;/span&gt;: &lt;span&gt;&quot;Generator&quot;&lt;/span&gt;, &lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; text-align: left; white-space: pre;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(252, 252, 252));&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span&gt;&quot;primary_technology_code&quot;&lt;/span&gt;: &lt;span&gt;&quot;&quot;&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; text-align: left; white-space: pre;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(252, 252, 252));&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span&gt;&quot;gt_esn&quot;&lt;/span&gt;: &lt;span&gt;&quot;&quot;&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; text-align: left; white-space: pre;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(252, 252, 252));&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span&gt;&quot;gen_esn&quot;&lt;/span&gt;: &lt;span&gt;&quot;270T483&quot;&lt;/span&gt;, &lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; text-align: left; white-space: pre;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(252, 252, 252));&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span&gt;&quot;st_esn&quot;&lt;/span&gt;: &lt;span&gt;&quot;&quot;&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; text-align: left; white-space: pre;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(252, 252, 252));&quot;&gt;&amp;nbsp; &