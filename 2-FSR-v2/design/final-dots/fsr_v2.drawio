  <diagram name="FSR - v1 (Prod)" id="RGiOmkFOMt0wTdcYtwKe">
    <mxGraphModel dx="1406" dy="814" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Y7XCHnATxAz0bf7OoakY-3" edge="1" parent="1" source="Y7XCHnATxAz0bf7OoakY-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Y7XCHnATxAz0bf7OoakY-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y7XCHnATxAz0bf7OoakY-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;PDF Parsing&lt;/div&gt;&lt;div&gt;Extract ESN from cover page and limited text windows&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="130" x="40" y="310" as="geometry" />
        </mxCell>
        <mxCell id="KIb1ewTgnTGKMX19Gwve-4" edge="1" parent="1" source="Y7XCHnATxAz0bf7OoakY-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="KIb1ewTgnTGKMX19Gwve-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y7XCHnATxAz0bf7OoakY-2" parent="1" style="whiteSpace=wrap;html=1;rounded=0;" value="Fetch related ESNs from upstream fsr_pdf_ref" vertex="1">
          <mxGeometry height="100" width="120" x="235" y="310" as="geometry" />
        </mxCell>
        <mxCell id="Y7XCHnATxAz0bf7OoakY-10" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Current FSR Production Pipeline (v1)&lt;/h1&gt;" vertex="1">
          <mxGeometry height="40" width="510" x="60" y="20" as="geometry" />
        </mxCell>
        <mxCell id="X6aUIW6Hf0GListewMUb-1" parent="1" style="whiteSpace=wrap;html=1;rounded=0;" value="&lt;div&gt;Chunking + Tagging (v1 behavior)&lt;/div&gt;&lt;div&gt;Assign one ESN/equipment type at document level to all chunks&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="175" x="600" y="310" as="geometry" />
        </mxCell>
        <mxCell id="jWxkfkD4A12788rj_-zS-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFFFF);fontSize=14;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;The Problem&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Multi-equipment FSRs (Gas Turbine + Generator on same document) have **two failure modes**:&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;1. **Retrieval miss** — User queries Generator ESN (e.g., `338X447`), but chunks are tagged with GT ESN → zero results. Affects ~17% of cross-ESN queries.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;2. **Wrong label** — Generator content (stator, rotor, field) is labeled &quot;Gas Turbine&quot; because the FSR listed the GT ESN first → LLM risk assessment confuses equipment type → wrong remediation recommendation.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="770" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="KIb1ewTgnTGKMX19Gwve-5" edge="1" parent="1" source="KIb1ewTgnTGKMX19Gwve-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="X6aUIW6Hf0GListewMUb-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KIb1ewTgnTGKMX19Gwve-3" parent="1" style="whiteSpace=wrap;html=1;rounded=0;" value="Duplicate the record for multiple ESNs" vertex="1">
          <mxGeometry height="100" width="120" x="410" y="310" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sf07U5hB2FJjyrMHAbxX" name="FSR - v2 Approach">
    <mxGraphModel dx="1907" dy="967" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hH0gsfMWCa3-bLmUM0AN-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;FSR v2 Parsing and Chunking Approach&lt;/h1&gt;" vertex="1">
          <mxGeometry height="40" width="560" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="hH0gsfMWCa3-bLmUM0AN-3" parent="1" style="whiteSpace=wrap;html=1;" value="&lt;div&gt;Chunking&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Map chunk offsets to region metadata&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Assign chunk-level ESN and equipment type&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="250" x="120" y="190" as="geometry" />
        </mxCell>
        <mxCell id="XFgppcYzRvAdW7BOY2f4-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontColor=light-dark(#000000,#FFFFFF);" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Consolas, Courier New, monospace&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Outputs:&lt;br&gt;metadata (document-level)&lt;br&gt;hints (for LLM normalization)&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;regions (start/end offsets + region metadata&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; white-space: pre;&quot;&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="340" x="-160" y="330" as="geometry" />
        </mxCell>
        <mxCell id="XFgppcYzRvAdW7BOY2f4-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#4D9900);fontSize=16;" value="&lt;div&gt;&lt;ul&gt;&lt;li&gt;Region attribution fixes ESN/equipment-type mapping.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(77, 153, 0));&quot;&gt;Enables retrieval across all ESNs associated with an FSR.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="520" x="-150" y="450" as="geometry" />
        </mxCell>
        <mxCell id="XFgppcYzRvAdW7BOY2f4-12" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="327.8" width="290.09" x="430" y="62.2" as="geometry" />
        </mxCell>
        <mxCell id="pYbRHW0ZBPfM7JO8h-Yp-5" edge="1" parent="1" source="S3ujQjTzneQSKsmPBPpa-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="hH0gsfMWCa3-bLmUM0AN-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="S3ujQjTzneQSKsmPBPpa-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;b&gt;Document Parsing&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Scan full PDF text for section headers, TOC cues, form patterns, and inactive markers&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="-160" y="195" as="geometry" />
        </mxCell>
        <mxCell id="pYbRHW0ZBPfM7JO8h-Yp-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Maps each page/chunk to the correct equipment by:&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;(uses preprocessor v1 baseline / v2 TOC-summary variant)&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; - Identifying section header boundaries (Gas Turbine vs Generator regions).&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; - Detecting field labels (`Gas Turbine ESN:`, `Generator ESN:`).&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; - Falling back to GE form numbers and keyword density if no clear boundary.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="500" x="-130" y="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
