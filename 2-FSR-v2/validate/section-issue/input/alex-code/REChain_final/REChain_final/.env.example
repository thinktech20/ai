# Databricks connectivity
DATABRICKS_HOST=https://gevernova-ai-dev-dbr.cloud.databricks.com
DATABRICKS_SERVER_HOSTNAME=gevernova-ai-dev-dbr.cloud.databricks.com
DATABRICKS_SQL_HTTP_PATH=/sql/1.0/warehouses/c383216f6af5c7c0
DATABRICKS_TOKEN=

# LiteLLM
LITELLM_BASE_URL=https://dev-gateway.apps.gevernova.net
LITELLM_API_KEY=
RE_CHAIN_MODEL=azure-gpt-5-2

# Self-managed Vector Search indexes
VS_INDEX_NAME=main.gp_services_sdg_poc.vs_field_service_report_gt_litellm
ER_VS_INDEX_NAME=main.gp_services_sdg_poc.vs_engineering_report_chunk_litellm
VECTOR_SEARCH_EMBEDDING_MODEL=azure-text-embedding-3-large-1
VECTOR_SEARCH_EMBEDDING_REQUEST_PATH=/v1/embeddings
VECTOR_SEARCH_EMBEDDING_DIMENSION=3072
VECTOR_SEARCH_EMBEDDING_VERIFY_SSL=false

# Batch/runtime tuning
RE_CHAIN_MAX_WORKERS=5
RE_CHAIN_OUTPUT_SUBDIR=output/10unitSL-chunk20-run1-ervs
RE_CHAIN_VERIFY_SSL=true
DBR_SECRET_SCOPE=fsr-pipeline